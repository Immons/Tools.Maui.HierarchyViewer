<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Immons.Tools.Maui.Inspector.Sync</RootNamespace>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>maui-inspector-sync</ToolCommandName>
		<IsPackable>true</IsPackable>
		<PackageId>Immons.Tools.Maui.Inspector.Sync</PackageId>
		<Title>Immons.Tools.Maui.Inspector.Sync</Title>
		<Description>XAML Updater — companion dotnet tool for Immons.Tools.Maui.Inspector: watches the in-app inspector for live property edits and writes them back into your XAML source files (WYSIWYG loop, pairs with IDE XAML Hot Reload).</Description>
		<PackageTags>maui;dotnet-maui;inspector;xaml;wysiwyg;hot-reload;devtools;dotnet-tool</PackageTags>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nugets\</PackageOutputPath>
	</PropertyGroup>

</Project>
